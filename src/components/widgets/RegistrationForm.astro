---
import { Icon } from 'astro-icon/components'
---

<div class="max-w-[800px] mx-auto p-6 bg-white rounded-lg space-y-6">
  <form id="registrationForm" class="space-y-6">
    <div>
      <label for="firstName" class="block text-sm font-semibold text-gray-700 mb-2">First Name</label>
      <input 
        type="text" 
        id="firstName" 
        name="firstName" 
        required 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-primary focus:ring-2 focus:ring-primary focus:ring-opacity-20 transition-colors placeholder-gray-400" 
        placeholder="Enter your first name"
      />
    </div>
    <div>
      <label for="lastName" class="block text-sm font-semibold text-gray-700 mb-2">Last Name</label>
      <input 
        type="text" 
        id="lastName" 
        name="lastName" 
        required 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-primary focus:ring-2 focus:ring-primary focus:ring-opacity-20 transition-colors placeholder-gray-400" 
        placeholder="Enter your last name"
      />
    </div>
    <div>
      <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email</label>
      <input 
        type="email" 
        id="email" 
        name="email" 
        required 
        class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:border-primary focus:ring-2 focus:ring-primary focus:ring-opacity-20 transition-colors placeholder-gray-400" 
        placeholder="your.email@example.com"
      />
    </div>
    <div class="flex items-start">
      <input 
        type="checkbox" 
        id="privacy" 
        name="privacy" 
        required 
        class="mt-1 w-4 h-4 text-primary border-2 border-gray-300 rounded focus:ring-primary focus:ring-2"
      />
      <label for="privacy" class="ml-3 text-sm text-gray-700">
        I declare to have read and understood SoCraTes IT's <a href="/privacy-policy" class="text-primary hover:underline font-medium">Privacy Policy</a>
      </label>
    </div>
    <div id="formMessage" class="hidden">
      <div id="loadingMessage" class="hidden flex items-center justify-center text-primary">
        <svg class="animate-spin h-5 w-5 mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Submitting your registration...</span>
      </div>
      <div id="errorMessage" class="hidden text-red-600 p-3 bg-red-50 rounded-lg text-sm">
        <p>There was an error submitting your registration. Please try again.</p>
      </div>
    </div>
    <button 
      type="submit" 
      id="submitBtn"
      disabled
      class="w-full bg-primary text-white font-semibold py-3 px-6 rounded-lg transition-all duration-200 disabled:bg-gray-300 disabled:cursor-not-allowed enabled:hover:bg-primary-dark enabled:hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary"
    >
      Subscribe and start the registration process
    </button>
  </form>
  <div class="p-6">
    <p>
      By subscribing to our newsletter, you’ll receive updates about the SoCraTes Italy conference, including the PDF
      form you’ll need to fill out and send to the hotel to reserve your spot. We respect your privacy and will not
      share your information with third parties.
    </p>
    <p class="mt-4 italic">
      You may experience issues when subscribing using browsers with strict privacy settings, such as Firefox. If you
      encounter any problems, we recommend trying a different browser or disabling strict privacy settings temporarily.
    </p>
  </div>
  {/* Rooms Section */}
  <div class="p-6">
    {/* Included Section */}
    <div class="mx-auto space-y-4">
      <h2 class="font-bold text-lg">What is included in the cost?</h2>
      <ul class="list-disc list-inside space-y-2">
        <li>
          <strong>Two nights full-board:</strong> breakfast, lunch, dinner and snack buffet all day (vegetarian and
          gluten-free food included!)
        </li>
        <li>
          The hotel has both twin and double rooms. If there is someone you are willing to share the room with, feel
          free to book the double room
        </li>
      </ul>
    </div>

    <div class="grid md:grid-cols-2 mx-auto mt-10">
      <div class="hover:bg-subtle flex flex-col items-center justify-center">
        <h4 class="font-medium">Shared double room</h4>
        <div class="flex items-center justify-center">
          <Icon name={'single-bed'} class="size-14 text-primary" />
          <Icon name={'single-bed'} class="size-14 text-primary" />
        </div>
        <p class="mt-2 text-subtitle italic">from € 280 per attendee</p>
      </div>

      <div class="flex flex-col items-center text-center">
        <h4 class="font-medium">Single room</h4>
        <Icon name={'single-bed'} class="size-14 text-primary" />
        <p class="mt-2 text-subtitle italic">from € 360 per attendee</p>
      </div>
    </div>
  </div>
</div>

<script>
  const WEB3FORMS_ACCESS_KEY = 'ba5f906f-9b6d-4531-a91d-1c485de41b89';
  
  const form = document.getElementById('registrationForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const inputs = form.querySelectorAll('input[required]');
  const formMessage = document.getElementById('formMessage') as HTMLDivElement;
  const loadingMessage = document.getElementById('loadingMessage') as HTMLDivElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLDivElement;
  
  function checkFormValidity() {
    let isValid = true;
    inputs.forEach((input) => {
      const inputEl = input as HTMLInputElement;
      if (inputEl.type === 'checkbox') {
        if (!inputEl.checked) {
          isValid = false;
        }
      } else {
        if (!inputEl.value.trim()) {
          isValid = false;
        }
      }
    });
    
    submitBtn.disabled = !isValid;
  }
  
  function showLoading() {
    formMessage.classList.remove('hidden');
    loadingMessage.classList.remove('hidden');
    errorMessage.classList.add('hidden');
    submitBtn.disabled = true;
  }
  
  function showError() {
    loadingMessage.classList.add('hidden');
    errorMessage.classList.remove('hidden');
    submitBtn.disabled = false;
  }
  
  function hideMessages() {
    formMessage.classList.add('hidden');
    loadingMessage.classList.add('hidden');
    errorMessage.classList.add('hidden');
  }
  
  async function handleSubmit(e: Event) {
    e.preventDefault();
    
    const firstName = (document.getElementById('firstName') as HTMLInputElement).value;
    const lastName = (document.getElementById('lastName') as HTMLInputElement).value;
    const email = (document.getElementById('email') as HTMLInputElement).value;
    
    showLoading();
    
    try {
      // Send to Web3Forms
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          access_key: WEB3FORMS_ACCESS_KEY,
          firstName: firstName,
          lastName: lastName,
          email: email,
          privacy: 'accepted',
          subject: 'New SoCraTes Italy Registration',
        }),
      });
      
      const result = await response.json();
      
      if (result.success) {
        // Build Google Forms URL with pre-filled data
        const googleFormUrl = new URL('https://forms.gle/BsWooYxTUhw4ybS96');
        
        // Note: Google Forms uses entry IDs for pre-filling
        // To find the entry IDs:
        // 1. Open your Google Form
        // 2. Click the three dots menu > Get pre-filled link
        // 3. Fill the form with test data and get the link
        // 4. The URL will contain parameters like entry.12345=value
        // 5. Use those entry IDs below
        const params = new URLSearchParams({
          // 'entry.XXXXXX': firstName,  // Replace XXXXXX with actual entry ID
          // 'entry.YYYYYY': lastName,   // Replace YYYYYY with actual entry ID
          // 'entry.ZZZZZZ': email,      // Replace ZZZZZZ with actual entry ID
        });
        
        // Redirect to Google Forms with pre-filled data
        // If no params are set, just redirect to the base URL
        if (params.toString()) {
          window.location.href = `${googleFormUrl.toString()}?${params.toString()}`;
        } else {
          window.location.href = googleFormUrl.toString();
        }
      } else {
        showError();
      }
    } catch (error) {
      console.error('Error submitting form:', error);
      showError();
    }
  }
  
  inputs.forEach((input) => {
    input.addEventListener(input.type === 'checkbox' ? 'change' : 'input', checkFormValidity);
    input.addEventListener('blur', checkFormValidity);
  });
  
  form.addEventListener('submit', handleSubmit);
  
  checkFormValidity();
</script>